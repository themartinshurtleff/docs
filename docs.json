{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TradeNet",
  "colors": {
    "primary": "#6f5200",
    "light": "#f0c040",
    "dark": "#8f6f22"
  },
  "redirects": [
    {
      "source": "/docs/:slug*",
      "destination": "/:slug*"
    }
  ],
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "installation",
              "account-and-access",
              "quickstart",
              "interface-tour",
              "feature-index"
            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "guides/layouts-and-charts",
              "guides/panes-tabs-and-linking",
              "guides/markets-and-timeframes",
              "guides/templates-themes-and-settings",
              "features/drawing-tools"
            ]
          },
          {
            "group": "Charts and Order Flow",
            "pages": [
              "features/footprint-charts",
              "features/bar-stats-and-indicators",
              "features/volume-profiles-and-tpo",
              "features/liquidation-heatmap",
              "guides/reading-the-heatmap",
              "features/liquidation-events",
              "features/orderbook-heatmap",
              "features/open-interest",
              "features/dom-and-tape",
              "features/multi-exchange",
              "features/markets-screener"
            ]
          },
          {
            "group": "Trading",
            "pages": [
              "trading/getting-started",
              "trading/order-types",
              "trading/order-management",
              "trading/advanced-orders",
              "integrations/bitunix-connect"
            ]
          },
          {
            "group": "Lua and Backtesting",
            "pages": [
              "indicators/creating-indicators",
              "indicators/runtime-and-data",
              "indicators/scripting-reference",
              "indicators/examples-and-recipes",
              "indicators/algo-automation",
              "indicators/backtesting",
              "indicators/ai-doc"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/updates",
              "support/data-quality",
              "support/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Blog",
        "groups": [
          {
            "group": "Updates",
            "pages": [
              "blog/beta-is-launching-soon",
              "blog/closed-beta-launch",
              "blog/why-we-built-tradenet"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Discord",
          "href": "https://discord.gg/tradenet",
          "icon": "discord"
        },
        {
          "anchor": "Website",
          "href": "https://tradenet.org",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/tradenet.png",
    "dark": "/logo/tradenet.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/tradenet"
      }
    ],
    "primary": {
      "type": "button",
      "label": "TradeNet Website",
      "href": "https://tradenet.org"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/tradenet",
      "x": "https://x.com/tradaborz"
    }
  }
}
