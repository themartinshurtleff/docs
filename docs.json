{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TradeNet",
  "colors": {
    "primary": "#c9a84c",
    "light": "#f0c040",
    "dark": "#c9a84c"
  },
  "favicon": "/favicon.png",
