      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "docs/introduction",
              "docs/installation",
              "docs/quickstart"
            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "docs/guides/layouts-and-charts",
              "docs/features/drawing-tools"
            ]
          },
          {
            "group": "Market Data",
            "pages": [
              "docs/features/footprint-charts",
              "docs/features/orderbook-heatmap",
              "docs/features/open-interest",
              "docs/features/dom-and-tape",
              "docs/features/multi-exchange"
            ]
          },
          {
            "group": "Liquidation Intelligence",
            "pages": [
              "docs/features/liquidation-heatmap",
              "docs/guides/reading-the-heatmap"
            ]
          },
          {
            "group": "Trading",
            "pages": [
              "docs/trading/getting-started",
              "docs/integrations/bitunix-connect",
              "docs/trading/order-types",
              "docs/trading/advanced-orders",
              "docs/trading/order-management"
            ]
          },
          {
            "group": "Custom Indicators",
            "pages": [
              "docs/indicators/creating-indicators",
              "docs/indicators/scripting-reference",
              "docs/indicators/ai-doc"
            ]
          }
        ]
      },
      {
        "tab": "Blog",
        "groups": [
          {
            "group": "Updates",
            "pages": [
              "blog/beta-is-launching-soon",
              "blog/closed-beta-launch",
              "blog/why-we-built-tradenet"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Discord",
          "href": "https://discord.gg/tradenet",
          "icon": "discord"
        },
        {
          "anchor": "Website",
          "href": "https://tradenet.org",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/tradenet.png",
    "dark": "/logo/tradenet.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/tradenet"
      }
